# =============================================================================
# Configuracoes de Ambiente - Hermes Agent News & Thumbnail Studio (TECH DIARIO)
# Copie este arquivo para .env e ajuste conforme sua infraestrutura local
# =============================================================================

# --- Motores LLM & Vetorizacao ---
OLLAMA_PORT=11434
QDRANT_PORT=6333
LLM_PORT=8080

EMBED_MODEL=nomic-embed-text
CLASSIFIER_MODEL=qwen2.5:1.5b
WRITER_MODEL=qwen3.5:9b

# --- Qwen-Image-2.1 Service (FastAPI / stable-diffusion.cpp) ---
QWEN_DIFFUSION_MODEL=qwen-image-2.1-Q3_K_XL.gguf
QWEN_VAE_MODEL=qwen_image_2.1_vae_bf16.safetensors
QWEN_TEXT_ENCODER=Qwen3-VL-8B-Instruct-UD-Q3_K_XL.gguf
QWEN_MMPROJ_MODEL=mmproj-F16.gguf
QWEN_IMAGE_PORT=8090
QWEN_DEFAULT_STEPS=20
QWEN_DEFAULT_CFG=4.5

# --- Hermes Agent Dashboard ---
HERMES_DASHBOARD_PORT=9119
TZ=America/Sao_Paulo
